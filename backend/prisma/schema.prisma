// Prisma schema for UNSAID platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MODERATOR
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FacebookStatus {
  NOT_PUBLISHED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(MODERATOR)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Post {
  id                  String           @id @default(uuid())
  content             String
  category            String
  moderationStatus    ModerationStatus @default(PENDING) @map("moderation_status")
  facebookStatus      FacebookStatus   @default(NOT_PUBLISHED) @map("facebook_status")
  facebookPostId      String?          @map("facebook_post_id")
  facebookPublishedAt DateTime?        @map("facebook_published_at")
  facebookError       String?          @map("facebook_error")
  createdAt           DateTime         @default(now()) @map("created_at")
  approvedAt          DateTime?        @map("approved_at")

  reports             Report[]
  likes               Like[]

  @@index([moderationStatus, createdAt])
  @@index([category])
  @@map("posts")
}

model Report {
  id         String       @id @default(uuid())
  postId     String       @map("post_id")
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  resolvedAt DateTime?    @map("resolved_at")

  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status])
  @@map("reports")
}

model Like {
  id                  String   @id @default(uuid())
  postId              String   @map("post_id")
  anonymousIdentifier String   @map("anonymous_identifier")
  createdAt           DateTime @default(now()) @map("created_at")

  post                Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, anonymousIdentifier])
  @@map("likes")
}
